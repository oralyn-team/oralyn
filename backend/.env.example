# Database Connection (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@host:port/dbname"

# Authentication Secrets
JWT_SECRET="your_jwt_secret_here"
JWT_ADMIN_SECRET="your_admin_jwt_secret_here"

# Resend Email Integration (Notificaciones de Citas y Recuperación de Contraseña)
RESEND_API_KEY="re_123456789_your_resend_api_key"
EMAIL_FROM="Oralyn <no-reply@oralyn.app>"

# Server Config
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
